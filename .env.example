# API Keys for Image Generation
OPENROUTER_API_KEY=sk-or-...
REPLICATE_API_TOKEN=...
IDEOGRAM_API_KEY=...

# Model Configuration
DEVICE=cuda  # or 'cpu' if GPU not available
NUM_WORKERS=4

# Data Collection
IMAGES_PER_GENERATOR=500
IMAGE_SIZE=1024
BATCH_SIZE=32

# Training
RANDOM_SEED=42
CV_FOLDS=4
TEST_SIZE=0.2

# Gradio Demo
GRADIO_PORT=7860
GRADIO_SHARE=True
