# RunPod Environment Configuration
# No API keys needed - all generators run locally on GPU!

# GPU Configuration
DEVICE=cuda
NUM_WORKERS=8

# Data Collection
IMAGES_PER_GENERATOR=500
IMAGE_SIZE=1024
BATCH_SIZE=32

# Training
RANDOM_SEED=42
CV_FOLDS=4
TEST_SIZE=0.2

# Gradio (for demo on RunPod)
GRADIO_PORT=7860
GRADIO_SHARE=False
